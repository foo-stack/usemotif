{
  "name": "@usemotif/ui",
  "version": "1.8.0",
  "description": "Batteries-included themed component kit for motif-js - install-and-go components composed over the primitives, headless behaviours, and recipes.",
  "homepage": "https://github.com/foo-stack/usemotif/tree/main/packages/ui#readme",
  "bugs": "https://github.com/foo-stack/usemotif/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foo-stack/usemotif.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/__tests__/**",
    "!src/**/__fixtures__/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@usemotif/recipes": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@usemotif/headless": "workspace:*",
    "@usemotif/tokens": "workspace:*",
    "jsdom": "^29.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "usemotif": "workspace:*",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@usemotif/headless": "workspace:^",
    "react": ">=18.0.0",
    "usemotif": "workspace:^"
  }
}
