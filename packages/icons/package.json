{
  "name": "@usemotif/icons",
  "version": "1.7.0",
  "description": "Cross-platform SVG icon primitive and bundled icon set for motif-js.",
  "homepage": "https://github.com/foo-stack/usemotif/tree/main/packages/icons#readme",
  "bugs": "https://github.com/foo-stack/usemotif/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foo-stack/usemotif.git",
    "directory": "packages/icons"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/__tests__/**",
    "!src/**/__fixtures__/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=8192' tsup",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit",
    "test": "vitest run",
    "generate": "node scripts/generate.mjs",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@usemotif/react": "workspace:*",
    "jsdom": "^29.1.0",
    "lucide-react": "1.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@usemotif/react": "workspace:^",
    "react": "^18.0.0 || ^19.0.0"
  }
}
