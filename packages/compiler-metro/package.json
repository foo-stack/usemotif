{
  "name": "@usemotif/compiler-metro",
  "version": "1.6.0",
  "description": "Metro transformer for motif-js static style extraction in React Native.",
  "homepage": "https://github.com/foo-stack/usemotif/tree/main/packages/compiler-metro#readme",
  "bugs": "https://github.com/foo-stack/usemotif/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foo-stack/usemotif.git",
    "directory": "packages/compiler-metro"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/__tests__/**",
    "!src/**/__fixtures__/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@usemotif/compiler-babel": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/babel__core": "^7.20.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@babel/core": "^7.20.0"
  }
}
