{
  "name": "@usemotif/react-native",
  "version": "1.8.0",
  "description": "React Native implementations of motif-js primitives. The native counterpart of @usemotif/react.",
  "homepage": "https://github.com/foo-stack/usemotif/tree/main/packages/react-native#readme",
  "bugs": "https://github.com/foo-stack/usemotif/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foo-stack/usemotif.git",
    "directory": "packages/react-native"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/__tests__/**",
    "!src/**/__fixtures__/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./flash-list": {
      "types": "./dist/virtualizers/flash-list.d.ts",
      "react-native": "./dist/virtualizers/flash-list.js",
      "import": "./dist/virtualizers/flash-list.js",
      "require": "./dist/virtualizers/flash-list.cjs"
    },
    "./reanimated": {
      "types": "./dist/_animation/reanimated.d.ts",
      "react-native": "./dist/_animation/reanimated.js",
      "import": "./dist/_animation/reanimated.js",
      "require": "./dist/_animation/reanimated.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@usemotif/core": "workspace:*"
  },
  "devDependencies": {
    "@shopify/flash-list": "^2.3.1",
    "@types/react": "^19.2.14",
    "@usemotif/test-utils": "workspace:*",
    "jsdom": "^29.1.0",
    "react": "^19.2.0",
    "react-native": "^0.83.0",
    "react-test-renderer": "^19.2.5",
    "test-renderer": "^1.3.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@shopify/flash-list": "^2.0.0",
    "@usemotif/test-utils": "workspace:^",
    "react": ">=18.0.0",
    "react-native": ">=0.74.0",
    "react-native-svg": ">=15.0.0",
    "test-renderer": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@shopify/flash-list": {
      "optional": true
    },
    "@usemotif/test-utils": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "test-renderer": {
      "optional": true
    }
  }
}
