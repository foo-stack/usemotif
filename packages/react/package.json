{
  "name": "@usemotif/react",
  "version": "1.8.0",
  "description": "DOM bindings for motif-js: Box / Stack / Pressable / styled() targeting React + react-dom.",
  "homepage": "https://github.com/foo-stack/usemotif/tree/main/packages/react#readme",
  "bugs": "https://github.com/foo-stack/usemotif/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foo-stack/usemotif.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/__tests__/**",
    "!src/**/__fixtures__/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./svg": {
      "react-native": {
        "types": "./dist/svg.native.d.ts",
        "default": "./dist/svg.native.js"
      },
      "types": "./dist/svg.d.ts",
      "import": "./dist/svg.js",
      "require": "./dist/svg.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./rsc": {
      "types": "./dist/rsc.d.ts",
      "import": "./dist/rsc.js",
      "require": "./dist/rsc.cjs"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js",
      "require": "./dist/devtools.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./tanstack-virtual": {
      "types": "./dist/virtualizers/tanstack.d.ts",
      "import": "./dist/virtualizers/tanstack.js",
      "require": "./dist/virtualizers/tanstack.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@usemotif/core": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.13.24",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@usemotif/react-native": "workspace:*",
    "@usemotif/test-utils": "workspace:*",
    "jsdom": "^29.1.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": "^3.0.0",
    "@usemotif/react-native": "workspace:^",
    "@usemotif/test-utils": "workspace:^",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-virtual": {
      "optional": true
    },
    "@usemotif/react-native": {
      "optional": true
    },
    "@usemotif/test-utils": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
