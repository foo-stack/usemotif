{
  "name": "@usemotif/storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Storybook preview helpers for motif: a theme switcher, breakpoint viewports and a direction toggle.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@storybook/react": "^10.4.1",
    "@types/react": "^19.2.14",
    "@usemotif/core": "workspace:*",
    "@usemotif/tokens": "workspace:*",
    "jsdom": "^29.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "usemotif": "workspace:*",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@storybook/react": ">=9.0.0",
    "react": ">=18.0.0",
    "usemotif": "workspace:^"
  }
}
