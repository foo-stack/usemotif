{
  "name": "@usemotif/uikit",
  "version": "0.0.14",
  "private": true,
  "description": "Storybook showcase for every Motif primitive, headless component, and motion hook (web + native via react-native-web).",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "storybook": "storybook dev -p 6006",
    "build": "storybook build",
    "build-storybook": "storybook build",
    "preview": "storybook build && vite preview --outDir storybook-static --port 6007",
    "serve-storybook": "vite preview --outDir storybook-static --port 6006 --strictPort",
    "visual-baseline": "playwright test --update-snapshots",
    "visual-check": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@usemotif/headless": "workspace:*",
    "@usemotif/icons": "workspace:*",
    "@usemotif/react-native": "workspace:*",
    "@usemotif/tokens": "workspace:*",
    "@usemotif/ui": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native-web": "^0.21.0",
    "usemotif": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/react": "^10.4.1",
    "@storybook/react-native-web-vite": "^10.4.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "react-native": "^0.83.0",
    "storybook": "^10.4.1",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  }
}
