{
  "name": "@usemotif/docs",
  "version": "0.0.15",
  "private": true,
  "description": "Documentation site for motif-js - built on vorge, dogfoods motif-js itself.",
  "type": "module",
  "scripts": {
    "dev": "vorge dev",
    "build": "vorge build",
    "preview": "vorge preview",
    "typecheck": "tsc --noEmit",
    "visual-baseline": "vorge build && playwright test --update-snapshots",
    "visual-check": "vorge build && playwright test",
    "cascade-check": "playwright test --config=playwright.cascade.config.ts",
    "comparison-check": "playwright test --config=playwright.comparison.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@usemotif/core": "workspace:*",
    "@usemotif/headless": "workspace:*",
    "@usemotif/tokens": "workspace:*",
    "@usemotif/ui": "workspace:*",
    "@vorge/cli": "^1.3.2",
    "@vorge/core": "^1.3.2",
    "@vorge/plugin-pagefind": "^1.3.2",
    "@vorge/plugin-sitemap": "^1.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "usemotif": "workspace:*",
    "vite": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/estree": "^1.0.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/unist": "^3.0.3",
    "@usemotif/tsconfig": "workspace:*",
    "acorn": "^8.16.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vitest": "^4.1.5"
  }
}
