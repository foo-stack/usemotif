{
  "name": "@usemotif/playground-native",
  "version": "0.0.18",
  "private": true,
  "description": "Expo demo of motif-js native primitives. Exercises Box / Stack / Text / Pressable / Image / Container with all three responsive shapes + theme switching.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "prebuild": "expo prebuild",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .expo .turbo dist"
  },
  "dependencies": {
    "@usemotif/react-native": "workspace:*",
    "@usemotif/tokens": "workspace:*",
    "expo": "^55.0.17",
    "react": "^19.2.0",
    "react-native": "^0.83.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.0",
    "@types/react": "^19.2.14",
    "typescript": "^6.0.3"
  }
}
