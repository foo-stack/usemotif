node_modules/
dist/
build/
.turbo/
.vorge/
coverage/
.next/
.astro/
.expo/
*.tsbuildinfo

# Next regenerates this on every build; let it own the formatting.
apps/*/next-env.d.ts
examples/*/next-env.d.ts

# TanStack Router regenerates its route tree on every build.
apps/*/src/routeTree.gen.ts

# oxfmt collapses indentation inside multi-line JS template literals that
# sit on JSX attributes (e.g. <CodeBlock code={`...`}>). The code samples in
# these MDX files are user-facing and must keep their authored indentation.
apps/docs/content/**/*.mdx

# Changesets regenerates these on every version bump, and the code samples
# inside them are user-facing release notes. Formatting them rewrites the
# published history of past releases - and it reflows the samples, which have
# the same authored-indentation concern as the MDX content above.
CHANGELOG.md
