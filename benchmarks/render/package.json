{
  "name": "@usemotif-bench/render",
  "version": "0.0.17",
  "private": true,
  "description": "Render-heavy benchmarks for motif-js: runtime vs compiled vs vanilla.",
  "type": "module",
  "scripts": {
    "bench": "panda codegen && vitest bench --run",
    "bench:report": "panda codegen && vitest bench --run --reporter=verbose",
    "typecheck": "panda codegen && tsc --noEmit",
    "css-size": "node css-size.mjs"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@tamagui/config": "^2.7.7",
    "@tamagui/core": "^2.7.7",
    "@usemotif/core": "workspace:*",
    "@usemotif/react": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.12.0",
    "@stylexjs/stylex": "^0.19.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
