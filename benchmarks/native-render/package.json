{
  "name": "@usemotif-bench/native-render",
  "version": "0.0.16",
  "private": true,
  "description": "Native-side render perf benchmarks for motif-js - compile-path, motion-exit, virtualized list mount.",
  "type": "module",
  "scripts": {
    "bench": "vitest bench --run",
    "bench:report": "vitest bench --run --reporter=verbose",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shopify/flash-list": "^2.3.1",
    "@usemotif/core": "workspace:*",
    "@usemotif/react-native": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
