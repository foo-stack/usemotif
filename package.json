{
  "name": "usemotif-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-platform React styling library for web, React Native, and desktop.",
  "homepage": "https://github.com/foo-stack/usemotif#readme",
  "bugs": "https://github.com/foo-stack/usemotif/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foo-stack/usemotif.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tooling/*",
    "examples/*",
    "benchmarks/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "oxlint",
    "format": "oxfmt --ignore-path .oxfmtignore",
    "format:check": "oxfmt --check --ignore-path .oxfmtignore",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "yarn build && node scripts/release.mjs",
    "release:local": "node scripts/publish.mjs",
    "verify:publish": "node scripts/check-publish-manifests.mjs",
    "size": "node scripts/check-sizes.mjs",
    "size:update": "node scripts/check-sizes.mjs --update",
    "treeshake": "node scripts/check-tree-shaking.mjs",
    "docs:check": "node scripts/check-docs-layer-order.mjs",
    "callout:check": "node scripts/check-callout-variants.mjs",
    "docs-esm:check": "node scripts/check-docs-esm.mjs",
    "bench:check": "node scripts/check-bench.mjs",
    "bench:device-gate": "node scripts/check-device-bench.mjs --results benchmarks/rn-startup/results/example.json",
    "tokens:check": "node scripts/check-token-types.mjs",
    "claims:check": "node scripts/check-claims.mjs",
    "writing:check": "node scripts/check-writing.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "tsup": "^8.5.1",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "resolutions": {
    "react-native": "0.83.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@4.13.0"
}
